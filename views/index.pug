doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title ひとこと掲示板
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
  body
    .container.py-4(style="max-width: 640px")
      h1.h3.mb-3= isAdmin ? 'ひとこと掲示板(管理画面)' : 'ひとこと掲示板'
      if !isAdmin
        form.mb-4(method="post" action="/posts")
          textarea.form-control.mb-2(name="content" rows="3" maxlength="280" required)
          button.btn.btn-primary(type="submit") 投稿
      each post in posts
        .card.mb-2
          .card-body
            p.card-text(style="white-space: pre-wrap")= post.content
            .d-flex.justify-content-between.align-items-center
              small.text-muted= post.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' })
              if isAdmin
                form(method="post" action=`/admin/posts/${post.id}/delete`)
                  button.btn.btn-sm.btn-outline-danger(type="submit") 削除
              else if post.postedBy === trackingId
                form(method="post" action=`/posts/${post.id}/delete`)
                  button.btn.btn-sm.btn-outline-danger(type="submit") 削除